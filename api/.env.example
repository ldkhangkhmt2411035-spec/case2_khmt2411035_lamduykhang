PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/task_manager?retryWrites=true&w=majority
JWT_SECRET=<chuoi_bi_mat_tu_dat>

# --- Gui email (nodemailer). Voi Gmail: bat xac minh 2 buoc roi tao "Mat khau ung dung" (App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<email_gui_di>
SMTP_PASS=<mat_khau_ung_dung>
MAIL_FROM=Task Manager <email_gui_di>

# Tat job nhac viec (24h truoc han) neu dat = false
ENABLE_REMINDERS=true
